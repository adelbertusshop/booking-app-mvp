-- TEST-ONLY baseline for the advertising migration tests.
-- Copied temporarily into supabase/migrations before the repository's legacy
-- appointment exclusion-constraint migration. Never deploy this fixture remotely.
create table public.salons (
  id uuid primary key default gen_random_uuid()
);

create table public.appointments (
  id bigint generated by default as identity primary key,
  salon_id uuid null references public.salons(id),
  start_time timestamptz not null,
  end_time timestamptz not null,
  status text not null default 'pending'
);
